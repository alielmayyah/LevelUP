    "info": {
      "weight": {
        "what": "Your total body weight: muscle, fat, bone, water, everything.",
        "why": "Weight alone can't tell fat from muscle. Read it together with your muscle and body fat.",
        "tip": "Aim for slow, steady change rather than quick drops. Your coach can help you set a target."
      },
      "muscle": {
        "what": "Skeletal muscle: the muscle you train and move with.",
        "why": "More muscle makes you stronger, protects your joints, and burns more calories even at rest.",
        "tip": "Lift weights regularly and eat enough protein. Going up is good news."
      },
      "bodyFat": {
        "what": "How much of your weight is fat, as a percentage.",
        "why": "It shows your fitness better than weight does, because it separates fat from muscle.",
        "tip": "Train regularly, sleep well, and eat a little less than you burn. Going down is good news."
      },
      "water": {
        "what": "All the water in your body: in your muscles, blood, and organs.",
        "why": "Staying hydrated keeps your energy up and helps you train and recover.",
        "tip": "Drink water through the day, and more on training days."
      },
      "protein": {
        "what": "The protein in your body, mostly in your muscles.",
        "why": "It shows whether your body has what it needs to build and keep muscle.",
        "tip": "Have some protein with every meal: chicken, eggs, fish, beans, or dairy."
      },
      "minerals": {
        "what": "The minerals in your body, mostly in your bones.",
        "why": "They keep your bones strong.",
        "tip": "Eat a varied diet with dairy and leafy greens. Strength training helps your bones too."
      },
      "bmr": {
        "what": "The calories your body burns in a day just to keep running, before any exercise.",
        "why": "It is the starting point for how much you can eat each day.",
        "tip": "Building muscle raises it a little, so strength training helps."
      },
      "bmi": {
        "what": "Your weight compared with your height.",
        "why": "A quick general check: 18.5–25 is the usual healthy range. It can't tell muscle from fat, so very muscular people can read high.",
        "tip": "Read it next to your body fat and muscle, not on its own."
      },
      "visceral": {
        "what": "Fat stored deep in your belly, around your organs.",
        "why": "A high level is linked to health risks, even in people who look slim.",
        "tip": "Lower is better. Regular exercise, good sleep, and less sugar help bring it down."
      }
    },
