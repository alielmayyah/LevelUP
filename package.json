{
  "name": "levelup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && tsc && vite build",
    "build:demo": "npm run lint && tsc && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:check": "vitest run src/i18n/i18n.test.ts",
    "check-colors": "node scripts/check-colors.mjs",
    "lint": "eslint --max-warnings 0 . && tsc -p tsconfig.e2e.json",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{ts,tsx,css,scss,json}\""
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/preferences": "^7.0.4",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@ionic/react": "^8.8.19",
    "@ionic/react-router": "^8.8.19",
    "gsap": "^3.15.1",
    "i18next": "^27.1.1",
    "ionicons": "^7.4.0",
    "motion": "^14.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
